{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freedomintelligence.github.io/3D-Coding-Blender/schemas/blender-edit-review-package-v1.json",
  "title": "Blender edit awaiting-review package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "edit_id", "kind", "source", "request_sha256", "targets", "changes", "non_target_drift", "reopen", "minimum_after_score", "visual_difference", "artifacts"],
  "properties": {
    "schema": {"const": "blender-edit-review-package/v1"},
    "status": {"const": "awaiting_review"},
    "edit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "kind": {"enum": ["material", "color", "geometry", "modeling", "scene"]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["filename", "sha256"],
      "properties": {"filename": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "request_sha256": {"$ref": "#/$defs/digest"},
    "targets": {"type": "object"},
    "changes": {"type": "object"},
    "non_target_drift": {"type": "array", "maxItems": 0},
    "reopen": {
      "type": "object", "additionalProperties": false, "required": ["verified", "snapshot_digest"],
      "properties": {"verified": {"const": true}, "snapshot_digest": {"$ref": "#/$defs/digest"}}
    },
    "minimum_after_score": {"type": "number", "minimum": 80, "maximum": 100},
    "visual_difference": {"$ref": "#/$defs/difference"},
    "artifacts": {
      "type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"enum": ["candidate.blend", "before.png", "after.png", "source_map.json"]},
        "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "difference": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "changed_fraction", "mean_absolute_delta"],
      "properties": {
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "changed_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_absolute_delta": {"type": "number", "minimum": 0, "maximum": 255}
      }
    }
  }
}
